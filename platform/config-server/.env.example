# IntelliJ 실행 구성 또는 프로세스 환경변수에 입력한다. 이 파일은 자동 로딩되지 않는다.
# xxxx는 미발급 placeholder이며 실제 실행 전 교체한다.
CONFIG_USER=recu-config
CONFIG_PASSWORD=xxxx
CONFIG_GIT_URI=https://github.com/LGCNS-MiniProject2-team6/recu-config.git
CONFIG_GIT_LABEL=main
# private HTTPS Git 사용 시에만 발급값 입력. local/public이면 빈 값으로 둔다.
CONFIG_GIT_USERNAME=xxxx
CONFIG_GIT_TOKEN=xxxx
EUREKA_URL=http://localhost:8761/eureka/

# Kafka Bus는 Kafka/토픽 준비 후 다섯 앱에서 true로 활성화한다.
BUS_ENABLED=false
BUS_DESTINATION=recu-config-bus-local
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# SASL 사용 시 실제 값은 IntelliJ 변수 표 또는 Secret으로 주입
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_JAAS_CONFIG=xxxx
# 암복호화·Bus 호출 공통 관리자. 두 값 모두 설정하며 CONFIG_USER와 다른 아이디 사용
CONFIG_ADMIN_USER=bus-admin
CONFIG_ADMIN_PASSWORD=xxxx

# Config 전용 암호화 키. 실제 값은 Git에 저장하지 않는다.
ENCRYPT_KEY=xxxx
