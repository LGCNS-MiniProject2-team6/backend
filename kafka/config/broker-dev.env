# recu-dev Kafka 브로커 설정. 비밀값 없음 → ConfigMap으로 그대로 사용 가능
#   kubectl -n recu-dev create configmap kafka-broker --from-env-file=kafka/config/broker-dev.env
# apache/kafka 이미지는 KAFKA_ 접두사 환경변수를 server.properties로 변환한다.
# KAFKA_ 환경변수를 하나라도 주면 이미지 기본 설정을 쓰지 않으므로 아래 값은 모두 필요하다.

# 단일 노드 KRaft: 한 프로세스가 broker + controller 역할을 겸한다
KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_CONTROLLER_QUORUM_VOTERS=1@localhost:9093
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER

# 9092: 앱 접속용, 9093: controller 내부용(Service로 노출하지 않음)
KAFKA_LISTENERS=PLAINTEXT://:9092,CONTROLLER://:9093
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT,CONTROLLER:PLAINTEXT
# bootstrap 이후 클라이언트에게 돌려주는 주소. Service 이름·Namespace를 바꾸면 같이 바꾼다
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka.recu-dev.svc.cluster.local:9092

# 데이터 디렉터리 최초 포맷에 쓰인다. 포맷 후 바꾸면 기동 실패하므로 고정한다
CLUSTER_ID=cmVjdS1kZXYta2Fma2EwMQ

# 브로커 1대이므로 내부 토픽 복제 수 1
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_SHARE_COORDINATOR_STATE_TOPIC_REPLICATION_FACTOR=1
KAFKA_SHARE_COORDINATOR_STATE_TOPIC_MIN_ISR=1
KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0

# 토픽은 kafka/topics 스크립트로만 만든다 (앱 binder도 auto-create=false)
KAFKA_AUTO_CREATE_TOPICS_ENABLE=false
KAFKA_NUM_PARTITIONS=1
KAFKA_LOG_RETENTION_HOURS=168

# PVC 마운트 경로
KAFKA_LOG_DIRS=/var/lib/kafka/data

# t3.medium(4GiB) data 노드 기준. 컨테이너 memory limit 1Gi와 맞춘다
KAFKA_HEAP_OPTS=-Xms512m -Xmx512m
